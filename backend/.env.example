# Database (matches docker-compose defaults for local dev)
DATABASE_URL=postgres://fenny:fenny@localhost:5432/fenny_booking?sslmode=disable

# JWT secret — CHANGE in production
JWT_SECRET=dev-secret-change-me

# Upload directory
UPLOAD_DIR=uploads

# HTTP port
PORT=8080

# WooCommerce sync (required only if using the admin "從官網同步材料包" button)
WOO_BASE_URL=https://flowers.fenny-studio.com
WOO_API_KEY=
WOO_API_SECRET=
# WooCommerce category slug to sync (defaults to my-diy)
WOO_CATEGORY_SLUG=my-diy

# Telegram notification (新詢問送出時通知管理員私訊；留空則停用通知)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
